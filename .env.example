# Server-side Gemini API key for optional AI Insight (set in Netlify environment).
# Never commit a real key or expose it as VITE_*.
GEMINI_API_KEY=

# Optional public dashboard base URL; Netlify also supplies URL automatically.
APP_URL=https://dashboardesb.netlify.app

# Omni Internal -> Dashboard ESB (Netlify Functions ONLY: do not prefix VITE_).
# Admin must provide these from Omni internal API documentation / credential issuer:
OMNI_API_BASE_URL=https://omni.example.com
OMNI_VISITS_PATH=/api/v1/visits
OMNI_API_TOKEN=

# Separate dashboard access secret (at least 24 characters).
# Generate using: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Share privately with authorized dashboard operators, never in source or URL:
OMNI_DASHBOARD_ACCESS_KEY=
